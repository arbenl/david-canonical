# ─────────────────────────────────────────────────────────────────────────────
# DAVID/M0.1 — environment variables
#
# Copy to .env and fill in values. Never commit .env to git.
# On Railway: set these via the dashboard (Variables tab).
# On Vercel: set DAVID_API_URL only (the rest stays on Railway).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (set automatically by Railway Postgres plugin) ──────────────────
DATABASE_URL=postgresql://david:david@localhost:5432/david

# ── LLM coding ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── CORS (comma-separated list of allowed frontend origins) ──────────────────
# Add your Vercel URL here when you have it
ALLOWED_ORIGINS=https://david-x8lj.vercel.app,http://localhost:3001

# ── Next.js (Vercel only) ────────────────────────────────────────────────────
# Set this in Vercel dashboard → Project Settings → Environment Variables
DAVID_API_URL=https://YOUR-RAILWAY-APP.railway.app
